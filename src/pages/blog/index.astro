---
import MainLayout from "../../layouts/main-layout.astro";
import "../../styles/global.css";

import { getBlogs, optimizeImage } from "../../lib/microcms";
const response = await getBlogs({
  fields: ["id", "title", "eyecatch", "publishedAt"],
  limit: 9999,
});

type Blog = (typeof response.contents)[number];

const groupedByYear = response.contents.reduce(
  (acc: Record<number, Blog[]>, blog) => {
    const year = new Date(blog.publishedAt!).getFullYear();
    if (!acc[year]) {
      acc[year] = [];
    }
    acc[year].push(blog);
    return acc;
  },
  {} as Record<number, Blog[]>,
);

const years = Object.keys(groupedByYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<MainLayout title="Blog">
  <div class="flex flex-col gap-16">
    {
      years.map((year) => (
        <div class="flex gap-4 flex-col md:flex-row-reverse">
          <h2 class="text-3xl font-bold text-gray-500">{year}</h2>
          <ul class="grid grid-cols-2 gap-3 md:gap-4 w-full">
            {groupedByYear[year].map((content) => (
              <li>
                <a
                  href={`/blog/${content.id}`}
                  class="flex flex-col gap-2 shadow-lg rounded-xl md:aspect-5/4 aspect-5/5 overflow-hidden group hover:outline-green-700 outline-2 outline-gray-100 focus-visible:outline-green-700 transition-all duration-300 ease-in-out"
                >
                  <span class="flex flex-col gap-1 px-2 md:px-4 pt-2 flex-1">
                    <span
                      class="font-bold text-sm min-[1000px]:text-base h-10"
                      transition:name={`title-${content.title}`}
                    >
                      {content.title.slice(0, 18)}
                      {content.title.length > 18 ? "..." : ""}
                    </span>
                    <span
                      class="text-xs md:text-sm text-gray-500"
                      transition:name={`publishedAt-${content.id}`}
                    >
                      <time datetime={content.publishedAt}>
                        {new Date(content.publishedAt!).toLocaleDateString()}
                        に公開
                      </time>
                    </span>
                  </span>
                  <div class="overflow-hidden shrink-0">
                    {content.eyecatch?.url ? (
                      <img
                        src={optimizeImage(content.eyecatch.url, {
                          width: 512,
                        })}
                        srcset={`${optimizeImage(content.eyecatch.url, { width: 512 })} 512w, ${optimizeImage(content.eyecatch.url, { width: 1200 })} 1200w`}
                        sizes="(max-width: 768px) 100vw, 50vw"
                        alt={content.title}
                        transition:name={`eyecatch-${content.id}`}
                        class="w-full aspect-video object-cover group-hover:scale-105 group-active:scale-100 transition-all duration-300 ease-in-out"
                      />
                    ) : (
                      <div class="w-full aspect-video bg-gray-200 flex items-center justify-center text-[36px] md:text-[72px] text-gray-500">
                        📝
                      </div>
                    )}
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</MainLayout>
