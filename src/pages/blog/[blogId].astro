---
import MainLayout from "../../layouts/main-layout.astro";
import { getBlogDetail, getBlogs, optimizeImage, optimizeContentImages } from "../../lib/microcms";

// 詳細記事ページの全パスを取得
export async function getStaticPaths() {
  const response = await getBlogs({ fields: ["id"], limit: 9999 });
  return response.contents.map((content: any) => ({
    params: {
      blogId: content.id,
    },
  }));
}

//記事の詳細情報を取得
const { blogId } = Astro.params;
const blog = await getBlogDetail(blogId as string);
---

<MainLayout title={blog.title}>
  <span class="text-sm text-gray-500" transition:name={`publishedAt-${blogId}`}>
    <time datetime={blog.publishedAt}
      >{new Date(blog.publishedAt!).toLocaleDateString()}</time
    >
    に公開
  </span>
  {
    blog.eyecatch?.url && (
      <div class="overflow-hidden w-full aspect-16/9">
        {
          <img
            transition:name={`eyecatch-${blogId}`}
            src={optimizeImage(blog.eyecatch.url, { width: 1200 })}
            srcset={`${optimizeImage(blog.eyecatch.url, { width: 512 })} 512w, ${optimizeImage(blog.eyecatch.url, { width: 1200 })} 1200w`}
            sizes="100vw"
            alt={blog.title}
            class="size-full object-cover"
          />
        }
      </div>
    )
  }
  <div class="markdown-container" set:html={optimizeContentImages(blog.content)} />
</MainLayout>
