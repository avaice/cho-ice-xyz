---
import { links } from "../constants/links";
import MobileLinks from "./mobilelinks.astro";

interface Props {
  nomobilemenu?: boolean;
}

const { nomobilemenu } = Astro.props;
---

<header class="shrink-0 sticky top-0 z-10">
  {
    (
      <div class="md:hidden flex justify-between p-4 bg-white">
        <a href="/" aria-label="Home">
          <img
            src="/avaice-80.webp"
            alt=""
            class="size-[40px]"
            width="40"
            height="40"
            loading="eager"
          />
        </a>
        <button
          id="menu-toggle"
          class={nomobilemenu ? "hidden" : ""}
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="menu"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-menu transition-transform duration-300"
          >
            <>
              <line x1="3" y1="12" x2="21" y2="12" />
              <line x1="3" y1="6" x2="21" y2="6" />
              <line x1="3" y1="18" x2="21" y2="18" />
            </>
          </svg>
        </button>
      </div>
    )
  }
  <nav
    id="menu"
    class="grid grid-rows-[0fr] transition-all duration-300 ease-out w-full bg-white px-4 overflow-hidden"
  >
    <div class="overflow-hidden">
      <div
        id="menu-content"
        class="transition-[opacity,transform] duration-200 ease-out pb-2"
      >
        <MobileLinks links={links} />
      </div>
    </div>
  </nav>

  <div class="bg-linear-to-b from-white/95 to-transparent h-[15px]"></div>

  <div class="hidden md:flex w-[150px] flex-col gap-4 ml-4 sticky top-16">
    <img
      src="/avaice-300.webp"
      alt=""
      class="size-[150px]"
      width="150"
      height="150"
      loading="eager"
    />
    <nav>
      <ul class="flex flex-col gap-3">
        {
          links.map((link) => (
            <li class="text-black w-full border-b block hover:text-green-700 transition">
              <a href={link.href} class="text-lg w-full inline-block">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("menu");
  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!isOpen));
      if (isOpen) {
        menu.classList.replace("grid-rows-[1fr]", "grid-rows-[0fr]");
      } else {
        menu.classList.replace("grid-rows-[0fr]", "grid-rows-[1fr]");
      }
    });
  }
</script>
