---
const daySrc = "/cover_day.jpeg";
const nightSrc = "/cover_night.jpeg";
---

<cover-image data-day-src={daySrc} data-night-src={nightSrc}>
  <div class="aspect-4/3 w-full bg-gray-200 rounded">
    <img alt="" class="w-full h-full object-cover rounded" />
  </div>
</cover-image>

<script>
  class CoverImage extends HTMLElement {
    constructor() {
      super();
      const img = this.querySelector("img")!;
      const hour = new Date().getHours();
      const isDay = hour >= 6 && hour < 18;
      img.src = isDay ? this.dataset.daySrc! : this.dataset.nightSrc!;
    }
  }
  customElements.define("cover-image", CoverImage);
</script>
